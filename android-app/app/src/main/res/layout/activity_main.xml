<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout android:id="@+id/navigationToolbar" android:layout_width="match_parent" android:layout_height="56dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp">
            <Button android:id="@+id/previousButton" android:layout_width="wrap_content"
                android:layout_height="match_parent" android:text="← 返回" android:textAllCaps="false"
                android:minWidth="48dp" android:paddingHorizontal="6dp" android:background="@android:color/transparent" android:textColor="@color/text_primary" />
            <TextView android:id="@+id/navigationTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="一起看" android:gravity="center" android:textColor="@color/text_primary" android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/browserToolbar"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="2dp"
            android:visibility="gone">

            <Button
                android:id="@+id/findAgainButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:padding="0dp" android:minWidth="0dp" android:background="@drawable/room_control"
                android:text="选集换源"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/inviteButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1.6"
                android:padding="0dp" android:minWidth="0dp" android:background="@drawable/room_invite"
                android:text="邀请朋友"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textStyle="bold" android:textColor="#381C15" />

            <Button
                android:id="@+id/fullscreenButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:padding="0dp" android:minWidth="0dp" android:background="@drawable/room_control"
                android:text="全屏"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#EEE9E6" />
        </LinearLayout>
            <Button android:id="@+id/moreButton" android:layout_width="48dp" android:layout_height="match_parent"
                android:minWidth="0dp" android:padding="0dp" android:text="•••" android:contentDescription="更多房间操作" android:background="@android:color/transparent" android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1C1B1D"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/status_preparing"
            android:textColor="#C4BBB6"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/finderToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">
            <Button android:id="@+id/finderCatalogButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="返回搜索" android:textSize="13sp" />
            <Button android:id="@+id/pickPageButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="选好这集，开始一起看" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <FrameLayout android:id="@+id/videoContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <FrameLayout android:id="@+id/roomContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/setupPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:fillViewport="true"
        android:background="#F6F7F9"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="28dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp"
                    android:src="@mipmap/ic_launcher" android:contentDescription="一起看" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="一起看" android:textSize="17sp" android:textStyle="bold" android:textColor="#23252C" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="好片，有人陪你看" android:textSize="11sp" android:textColor="#747985" />
                </LinearLayout>
                <Button android:id="@+id/setupBackButton" android:layout_width="48dp"
                    android:layout_height="48dp" android:minWidth="0dp" android:text="×" android:textSize="26sp"
                    android:contentDescription="关闭，返回选片" android:padding="0dp"
                    android:background="@android:color/transparent" android:textColor="#686C77" />
            </LinearLayout>

            <TextView
                android:id="@+id/setupTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加入朋友房间"
                android:textColor="#23252C"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/setupHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="start"
                android:text="粘贴邀请，自动打开朋友正在看的影片。"
                android:textColor="#737782"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/roomInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:minHeight="56dp"
                android:background="@drawable/entry_input"
                android:hint="邀请链接 / 房间号"
                android:contentDescription="邀请链接或房间号"
                android:inputType="textUri"
                android:maxLength="256"
                android:singleLine="true"
                android:textSize="15sp"
                android:textColor="#242730"
                android:textColorHint="#7A7E88" />

            <EditText
                android:id="@+id/nicknameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:background="@drawable/entry_input"
                android:hint="房间昵称"
                android:contentDescription="房间昵称"
                android:inputType="textPersonName"
                android:maxLength="32"
                android:singleLine="true"
                android:textSize="15sp"
                android:textColor="#242730"
                android:textColorHint="#7A7E88" />

            <EditText
                android:id="@+id/videoUrlInput"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/entry_input"
                android:hint="@string/video_url_hint"
                android:inputType="textUri"
                android:maxLength="2048"
                android:singleLine="true"
                android:textSize="15sp"
                android:textColor="#242730"
                android:textColorHint="#7A7E88" />

            <Button
                android:id="@+id/sampleButton"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="选择开放短片试播"
                android:textAllCaps="false" />

            <CheckBox
                android:id="@+id/consentCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:buttonTint="#C6533C"
                android:text="@string/consent_text"
                android:textColor="#737782"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/legalLinks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/termsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:text="查看用户协议"
                    android:textAllCaps="false"
                    android:textColor="#A64734" />

                <Button
                    android:id="@+id/privacyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:text="查看隐私政策"
                    android:textAllCaps="false"
                    android:textColor="#A64734" />
            </LinearLayout>

            <Button
                android:id="@+id/entryAdvancedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="昵称 / 手动链接"
                android:background="@android:color/transparent"
                android:textColor="#737782"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/openVideoButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/entry_primary"
                android:backgroundTint="@null"
                android:text="加入房间"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/setupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="#B1364C"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/popupContainer"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="bottom|end"
        android:importantForAccessibility="noHideDescendants" />

    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>
