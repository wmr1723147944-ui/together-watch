# 把此文件复制为 .env.server，再替换下面两项。
DOMAIN=watch.example.com
SECRET_KEY=replace-with-output-from-openssl-rand-hex-32
SERVICE_OPERATOR_NAME=
COPYRIGHT_CONTACT_EMAIL=

# 默认留空最安全。仅登记自有或已取得书面授权的域名，多个域名用英文逗号分隔。
AUTHORIZED_MEDIA_HOSTS=
AUTHORIZED_PAGE_HOSTS=

# 找片入口下架设置：按 ID 填写，多个 ID 用英文逗号分隔；留空显示全部。
# 平台：bilibili,tencent,youku；影片 ID 见 SOURCE_DISCOVERY_2026-10-14.md。
DISCOVERY_DISABLED_PROVIDERS=
DISCOVERY_DISABLED_FILMS=

# 默认留空时使用项目内置 STUN。配置 TURN 后，把单行 JSON 写在等号后面。
WEBRTC_ICE_SERVERS=
