SECRET_KEY=replace-with-a-long-random-value
APP_ENV=production
APP_VERSION=personal-v1
PORT=5000
TRUST_PROXY_HOPS=1
ROOM_TTL_SECONDS=21600
MAX_ROOM_MEMBERS=50
MAX_CALL_MEMBERS=8
# 默认留空：任意媒体直链会被拒绝。仅填写你自有或已取得书面授权的媒体域名。
AUTHORIZED_MEDIA_HOSTS=
# 可选：除内置视频平台外，经你审核允许同步的自有网页域名。
AUTHORIZED_PAGE_HOSTS=
SERVICE_OPERATOR_NAME=
COPYRIGHT_CONTACT_EMAIL=
ALLOWED_ORIGINS=https://watch.example.com
GUNICORN_THREADS=40
# 默认内置公共 STUN；公网正式部署建议配置 TURN，供语音通话穿透复杂网络。
# WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"replace-me","credential":"replace-me"}]
# 多实例部署时配置 Redis，例如：
# SOCKETIO_MESSAGE_QUEUE=redis://redis:6379/0
